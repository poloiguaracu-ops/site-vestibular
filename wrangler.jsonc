{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-vestibular",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "main": "src/index.js",
  "kv_namespaces": [
    {
      "binding": "VESTIBULAR_KV",
      "id": "ace1f7655e0144119b0dab0180add78c"
    }
  ]
}